# Django
DEBUG=True
SECRET_KEY=change-me-to-a-random-secret-key
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1

# Database (matches docker-compose.yml postgres service)
POSTGRES_DB=floorcraft_db
POSTGRES_USER=floorcraft_admin
POSTGRES_PASSWORD=supersecretpassword
DATABASE_URL=postgres://floorcraft_admin:supersecretpassword@postgres:5432/floorcraft_db

# Frontend (Vite exposes only variables prefixed with VITE_ to client-side code)
VITE_API_BASE_URL=/api
